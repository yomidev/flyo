---
import TestimonialCard from "./TestimonialCard.astro";

const testimonials = [
  {
    text: "Fylo has improved our team productivity by an order of magnitude.",
    name: "Satish Patel",
    role: "Founder & CEO, Huddle",
    avatar: "/images/profile-1.jpg",
  },
  {
    text: "Fylo has improved our team productivity by an order of magnitude.",
    name: "Bruce McKenzie",
    role: "Founder & CEO, Huddle",
    avatar: "/images/profile-2.jpg",
  },
  {
    text: "Fylo has improved our team productivity by an order of magnitude.",
    name: "Iva Boyd",
    role: "Founder & CEO, Huddle",
    avatar: "/images/profile-3.jpg",
  },
];
---

<section class="mt-32 px-10 md:px-40">
  <div class="grid md:grid-cols-3 gap-8">
    {testimonials.map((testimonial) => <TestimonialCard {...testimonial} />)}
  </div>
</section>
