---
import FeatureCard from "./FeatureCard.astro";

const features = [
  {
    icon: "/images/icon-access-anywhere.svg",
    title: "Access your files, anywhere",
    text: "The ability to use a smartphone, tablet, or computer to access your account means your files follow you everywhere.",
  },
  {
    icon: "/images/icon-security.svg",
    title: "Security you can trust",
    text: "2-factor authentication and user-controlled encryption are just a couple of the security features we allow to help secure your files.",
  },
  {
    icon: "/images/icon-collaboration.svg",
    title: "Real-time collaboration",
    text: "Securely share files and folders with friends, family and colleagues for live collaboration.",
  },
  {
    icon: "/images/icon-any-file.svg",
    title: "Store any type of file",
    text: "Whether you're sharing holiday photos or work documents, Fylo has you covered allowing for all file types to be securely stored and shared.",
  },
];
---

<section class="mt-28 px-10 md:px-40">
  <div class="grid md:grid-cols-2 gap-20">
    {
      features.map((feature) => (
        <FeatureCard
          icon={feature.icon}
          title={feature.title}
          text={feature.text}
        />
      ))
    }
  </div>
</section>
