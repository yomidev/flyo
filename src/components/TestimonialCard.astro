---
const { text, name, role, avatar } = Astro.props;
---

<div class="bg-[#202a3c] p-8 rounded-lg">
  <p class="text-sm text-gray-300">
    {text}
  </p>
  <div class="flex items-center mt-6 gap-16">
    <img src={avatar} alt={name} class="w-8 h-8 rounded-full" />
    <div class="text-xs">
      <p class="font-bold">{name}</p>
      <p class="text-gray-400">{role}</p>
    </div>
  </div>
</div>
